# Names only. Copy to .env.local for local work and set the same names in the
# Vercel project settings for production. Never commit real values.
# See README.md ("Environment variables") for where each value comes from.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Clerk: Dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk user id of the site owner (Dashboard > Users > the owner's user_...)
ADMIN_CLERK_USER_ID=

# Resend: API Keys, and a verified sending domain
RESEND_API_KEY=
EMAIL_FROM=

# Long random string. Generate with: openssl rand -hex 32
VISITOR_SALT_SECRET=

# Public origin of the site, no trailing slash. Required in production.
SITE_URL=

# Optional
# LOG_LEVEL=info
